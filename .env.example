# ---------------------------------------------------------------------------
# Hidden admin area (/admin). See docs/ADMIN.md.
#
# Each editor enters their OWN Claude/Gemini key, GitHub token and repo on
# their "My account" page. Those are stored encrypted in Supabase. The site
# itself only needs the settings below.
# ---------------------------------------------------------------------------

# Head admin: sign in with username "admin" and this password to invite editors.
ADMIN_PASSWORD=

# Supabase (Project Settings → API). Server-only: never expose the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters. Encrypts editors' keys and signs sessions.
# Generate: openssl rand -base64 48
# Don't change it later, or saved keys can't be decrypted (editors would re-enter them).
SECRETS_ENCRYPTION_KEY=

# Optional: models used by the formatter.
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.5-pro
