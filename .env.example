# Hidden admin page (/admin). Leave ADMIN_PASSWORD empty to disable it.
ADMIN_PASSWORD=
# Optional: extra secret mixed into session cookies.
ADMIN_SESSION_SECRET=

# AI formatter: at least one of these. Claude is the default.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# Publishing: fine-grained GitHub token with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=deoeclipse009/ursulinglobalstudies
GITHUB_BRANCH=main
